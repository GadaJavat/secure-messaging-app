# Demo values for this educational DES-CBC project.
# These NEXT_PUBLIC variables are exposed to the browser because the demo
# encrypts and decrypts messages client-side. Do not use this approach for
# real production security.
NEXT_PUBLIC_DES_SECRET_KEY=deskey12

# Optional legacy fallback IV for messages created before per-message random IVs.
# New messages generate and transmit their own fresh 8-byte IV.
NEXT_PUBLIC_DES_IV=initvect
